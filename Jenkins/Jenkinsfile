pipeline {
    agent any

    stages {
        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        stage("Build") {
            steps {
                sh "mvn clean install -Dheadless=true"
            }
        }

        stage ("Test"){
            steps{
                sh "mvn test -Dheadless=true"
            }
        }
    }
}