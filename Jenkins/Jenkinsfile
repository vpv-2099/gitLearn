pipeline {
    agent any

    environment {
        SELENIUM_REMOTE_URL = "http://localhost:4444/wd/hub"
    }

    stages {

        stage("Start Selenium") {
            steps {
                sh """
                docker run -d -p 4444:4444 --name selenium \
                --shm-size=2g seleniarm/standalone-chromium
                """
            }
        }

        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        stage("Test") {
            agent {
                docker {
                    image 'maven:3.9.9-eclipse-temurin-17'
                }
            }
            steps {
                sh "mvn test -Dheadless=true"
            }
        }

        stage("Stop Selenium") {
            steps {
                sh "docker stop selenium || true"
                sh "docker rm selenium || true"
            }
        }
    }
}