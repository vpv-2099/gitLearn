pipeline {
    agent {
        docker {
            image 'seleniarm/standalone-chromium'
            args '--shm-size=2g'
        }
    }

    environment {
        SELENIUM_REMOTE_URL = "http://localhost:4444/wd/hub"
    }

    stages {
        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        stage("Test") {
            steps {
                sh "mvn test -Dheadless=true"
            }
        }
    }
}